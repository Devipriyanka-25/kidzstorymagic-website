# Kidz Story Magic web environment template.
# Copy to frontend/.env.local for local Next.js development.
# NEXT_PUBLIC_* values are bundled into the browser, so never place secrets here.

NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kidz Story Magic
ADMIN_EMAILS=you@example.com

# Replicate API – used server-side only, NEVER expose to the browser
# Get your token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Phase 1 / Identity-consistent generation ─────────────────────────────────
# Set to REPLICATE_IDENTITY to use identity models as the primary generation flow.
# Leave unset or set to any other value to keep the legacy SDXL + face-swap flow.
IMAGE_PROVIDER=REPLICATE_IDENTITY

# When true, fall back to face swap if identity generation fails.
ENABLE_FACE_SWAP_FALLBACK=true

# Which Replicate identity model to use as primary provider.
# Options: photomaker | instantid | ipadapter | flux_lora
REPLICATE_IDENTITY_MODEL=photomaker

# Optional: pin specific Replicate model versions (leave blank to auto-resolve)
REPLICATE_PHOTOMAKER_VERSION=
REPLICATE_INSTANTID_VERSION=
REPLICATE_IPADAPTER_VERSION=
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Kidz Story Magic <onboarding@resend.dev>"
RESEND_REPLY_TO_EMAIL=support@kidzstorymagic.com
PREVIEW_REQUEST_NOTIFICATION_EMAIL=support@kidzstorymagic.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_DEBUG_MODE=false
