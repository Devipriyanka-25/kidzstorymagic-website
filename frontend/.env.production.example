# Kidz Story Magic - Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Authentication
NEXT_PUBLIC_AUTH_STORAGE_KEY=authToken

# Stripe Public Key (get from Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxx

# Feature Flags
NEXT_PUBLIC_ENABLE_PHOTO_UPLOAD=true
NEXT_PUBLIC_ENABLE_CURRENCY_CONVERSION=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Sentry (optional error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Environment
NODE_ENV=development
