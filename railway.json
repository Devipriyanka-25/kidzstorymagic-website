{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1,
    "startCommand": "npm start"
  },
  "domains": [
    {
      "domain": "kidzstorymagic-api.railway.app"
    }
  ]
}
