# Production web environment template.
# Configure these in the hosting provider. Do not commit production .env files.

NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_APP_NAME=Kidz Story Magic
NEXT_PUBLIC_ENABLE_PREVIEW_FACE_SWAP=true
ADMIN_EMAILS=you@example.com

# Supabase Configuration - REQUIRED FOR AUTH & PASSWORD RESET
# Get these from https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database URL for backend operations
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Replicate API for Face Swap
# Get your token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepAI for Face Swap
DEEPAI_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Email Service (Resend) - REQUIRED FOR PASSWORD RESET EMAILS
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Kidz Story Magic <noreply@kidzstorymagic.com>"
RESEND_REPLY_TO_EMAIL=support@kidzstorymagic.com
PREVIEW_REQUEST_NOTIFICATION_EMAIL=support@kidzstorymagic.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Email Verification
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_DEBUG_MODE=false
