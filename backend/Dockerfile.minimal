# Ultra-minimal Dockerfile for Railway - Core backend only
FROM node:20-alpine

WORKDIR /app

# Install only essential system packages
RUN apk add --no-cache \
    ca-certificates \
    curl

# Configure npm and Node for speed
ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=512
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Copy package files
COPY package*.json ./

# Install production dependencies with aggressive optimization
# - --only=production: skip devDependencies
# - --ignore-scripts: skip build scripts (prevents native module compilation)
# - --prefer-offline: use cached packages
# - --legacy-peer-deps: skip peer dependency warnings
# - --no-fund: skip funding checks
# - --audit=false: skip security audits
RUN npm ci \
    --only=production \
    --ignore-scripts \
    --prefer-offline \
    --legacy-peer-deps \
    --no-fund \
    --audit=false \
    && npm cache clean --force

# Copy application source
COPY src ./src

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Start application
CMD ["node", "src/index.js"]
