# Kidz Story Magic API environment template.
# Copy to backend/.env for local API development. Do not commit real secrets.

# App
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database
# Use DATABASE_URL for hosted Postgres, or the DB_* values for local Postgres.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kidz_story_magic
DB_USER=postgres
DB_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Currency
EXCHANGE_RATE_API_KEY=

# Story and image generation
IMAGE_PROVIDER=DEMO
OPENAI_API_KEY=
STABILITY_API_KEY=
STABLE_DIFFUSION_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional face swap
ENABLE_FACE_SWAP=false
REPLICATE_API_TOKEN=

# Optional storage
UPLOAD_DIR=./uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=story-images
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# Optional image analysis
AZURE_VISION_ENDPOINT=
AZURE_VISION_API_KEY=

# PDF generation
CHROMIUM_PATH=

# Email for password reset
EMAIL_SERVICE=gmail
EMAIL_FROM=noreply@kidzstorymagic.com
EMAIL_USER=
EMAIL_PASSWORD=
