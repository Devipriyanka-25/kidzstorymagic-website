# Optional photo upload and Azure storage variables.
# Copy needed keys into backend/.env or your deployment secret manager.

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=story-images

# Azure Computer Vision
AZURE_VISION_ENDPOINT=
AZURE_VISION_API_KEY=

# Image processing settings
IMAGE_UPLOAD_MAX_SIZE=52428800
IMAGE_CROP_WIDTH=800
IMAGE_CROP_HEIGHT=1000
IMAGE_BLUR_RADIUS=30
IMAGE_WATERMARK_TEXT=PREVIEW
IMAGE_WATERMARK_OPACITY=0.3

# SAS URL generation
SAS_URL_EXPIRY_MINUTES=60
SAS_URL_PREVIEW_EXPIRY_DAYS=7
