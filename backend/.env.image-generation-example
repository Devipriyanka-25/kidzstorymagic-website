# .env.image-generation-example
# Copy values from your chosen provider to .env file

# ============================================
# IMAGE GENERATION CONFIGURATION
# ============================================

# Choose which provider to use:
# - DALLE (recommended)
# - STABLE_DIFFUSION
# - MIDJOURNEY
# - AZURE
# - PLACEHOLDER (default, shows no images)

IMAGE_PROVIDER=DALLE

# ============================================
# DALL-E 3 CONFIGURATION (OpenAI)
# ============================================
# Cost: $0.080 per image
# Setup: Get from https://platform.openai.com/api-keys
# 
# Step 1: Sign up at https://platform.openai.com/
# Step 2: Go to API Keys section
# Step 3: Create new secret key
# Step 4: Copy the key starting with "sk-"
# Step 5: Paste below

OPENAI_API_KEY=sk_your_api_key_here_xxx

# ============================================
# STABLE DIFFUSION CONFIGURATION
# ============================================

# For Cloud (Stability AI):
# Cost: $0.025 per image  
# Setup: Get from https://www.stabilityai.com/
STABILITY_API_KEY=sk_stable_diffusion_key_here

# For Local WebUI (Free):
# Setup: Install from https://github.com/AUTOMATIC1111/stable-diffusion-webui
# Run : ./webui.bat (Windows) or ./webui.sh (Linux/Mac)
STABLE_DIFFUSION_URL=http://127.0.0.1:7860/api

# ============================================
# MIDJOURNEY + REPLICATE CONFIGURATION
# ============================================
# Cost: $0.10-0.30 per image
# Setup: Get token from https://replicate.com/
# 
# Step 1: Sign up at https://replicate.com/
# Step 2: Go to Settings > API tokens
# Step 3: Copy your token
# Step 4: Paste below

REPLICATE_API_TOKEN=r8_your_replicate_token_here_xxx

# ============================================
# AZURE OPENAI CONFIGURATION
# ============================================
# Cost: $0.080 per image
# Setup: Azure Portal OpenAI resource
#
# Step 1: Create OpenAI resource in Azure Portal
# Step 2: Deploy DALL-E 3 model
# Step 3: Get credentials from "Keys and Endpoints"
# Step 4: Paste values below

AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=dall-e-3

# ============================================
# IMAGE GENERATION SETTINGS
# ============================================

# Image size
IMAGE_SIZE=1024x1024

# Quality level (for DALLE)
# Options: standard, hd
IMAGE_QUALITY=standard

# Style (for DALLE)
# Options: vivid, natural
IMAGE_STYLE=vivid

# Enable image caching (future feature)
IMAGE_CACHE_ENABLED=false
IMAGE_CACHE_TTL=86400

# Max retries for failed generations
IMAGE_MAX_RETRIES=3

# Timeout for image generation (milliseconds)
IMAGE_GENERATION_TIMEOUT=60000
