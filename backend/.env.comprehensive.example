# Kidz Story Magic - Backend Environment Configuration
# ============================================
# IMPORTANT: Copy this file to .env.local and fill in YOUR values
# NEVER commit .env.local to version control!
# ============================================

# ============================================
# Application Environment
# ============================================
# Environment: development, staging, production
NODE_ENV=development
# Port to run the backend server
PORT=5000
# Base URL for the application
BASE_URL=http://localhost:5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Option 1: Use DATABASE_URL (for cloud databases like Supabase, Railway, Render)
# Get connection string from your cloud provider
# Format: postgresql://user:password@host:port/database
# Uncomment the line below if using cloud database:
# DATABASE_URL=postgresql://postgres:password@db.example.com:5432/kidz_story_magic

# Option 2: Use individual DB variables (for local PostgreSQL)
# Only used if DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kidz_story_magic
DB_USER=postgres
DB_PASSWORD=your_password_here

# ============================================
# JWT Configuration (Authentication)
# ============================================
# Generate a strong random string for production
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production
# Token expiration time
JWT_EXPIRES_IN=7d

# ============================================
# STRIPE Configuration (Payments)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
# Secret key (KEEP PRIVATE!)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Publishable key (can be public)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Webhook secret
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================
# External APIs & Services
# ============================================

# Currency Exchange API (for multi-currency support)
# Get from: https://exchangerate-api.com or similar
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# AWS Configuration (for S3 storage and Rekognition - optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=kidz-story-magic-uploads
AWS_S3_URL=https://your-bucket.s3.amazonaws.com

# OpenAI Configuration (for story generation)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Azure Vision API (for face detection - optional)
AZURE_CV_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_CV_KEY=your_azure_cv_key_here

# ============================================
# Email Configuration
# ============================================
# Email provider: gmail, sendgrid, smtp
EMAIL_SERVICE=gmail
# Email from address
EMAIL_FROM=noreply@kidzstorymagic.com
# For Gmail: App Password (not your regular password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# For SendGrid:
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=debug
# Log format: simple, json
LOG_FORMAT=simple

# ============================================
# Rate Limiting
# ============================================
# Rate limit window in minutes
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Session Configuration
# ============================================
# Session timeout in milliseconds (24 hours)
SESSION_TIMEOUT=86400000
# Redis URL for session storage (optional)
# REDIS_URL=redis://localhost:6379

# ============================================
# File Upload Configuration
# ============================================
# Max upload file size in bytes (5 MB)
MAX_FILE_SIZE=5242880
# Allowed image types (comma-separated MIME types)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ============================================
# Feature Flags (optional)
# ============================================
# Enable or disable features
ENABLE_IMAGE_GENERATION=true
ENABLE_FACE_SWAP=false
ENABLE_PAYMENT=true
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================
# Analytics & Monitoring (optional)
# ============================================
# Sentry DSN for error tracking
SENTRY_DSN=https://your_sentry_key_here@sentry.io/project_id

# ============================================
# WhatsApp Business Integration
# ============================================
# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id_here
# WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# WhatsApp Business API Token
WHATSAPP_API_TOKEN=EAABx...your_token_here
# WhatsApp Business Account Phone (for display)
WHATSAPP_BUSINESS_PHONE=+917385983456

# ============================================
# Security Settings
# ============================================
# Enable HTTPS only (set to true in production)
FORCE_HTTPS=false
# Enable HSTS (HTTP Strict Transport Security)
HSTS_MAX_AGE=31536000
# Enable helmet security headers
ENABLE_HELMET=true

# ============================================
# Development Settings
# ============================================
# Enable debug logging
DEBUG=false
# Enable mock data for testing
USE_MOCK_DATA=false
# Allow API requests from different origins (development only!)
ALLOW_INSECURE_ORIGINS=true

# ============================================
# Monitoring & Performance
# ============================================
# Node cluster mode (multi-process)
CLUSTER_MODE=false
# Number of worker processes (if cluster mode enabled)
WORKER_PROCESSES=4
