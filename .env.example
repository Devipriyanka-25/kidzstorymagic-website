# Root environment template for Docker Compose.
# Copy to .env for local Docker runs. Do not commit real .env files.

# App URLs
NODE_ENV=development
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kidz_story_magic
DB_USER=postgres
DB_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_KEY=

# Optional integrations
EXCHANGE_RATE_API_KEY=
OPENAI_API_KEY=
IMAGE_PROVIDER=DEMO
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
ENABLE_FACE_SWAP=false

# Email for password reset
EMAIL_SERVICE=gmail
EMAIL_FROM=noreply@kidzstorymagic.com
EMAIL_USER=
EMAIL_PASSWORD=

# Storage and processing
UPLOAD_DIR=./uploads
CHROMIUM_PATH=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=story-images
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_API_KEY=

# Logging
LOG_LEVEL=info
