# Frontend Environment Variables
# Copy to .env.local for local development
# These are public variables (visible in browser)

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Stripe (Public Key - Safe to expose)
# Test: pk_test_51TFzKkLe1SkPHCDJuBDTwa0IKXATeoSLi9CF9t68iOtxH8zZirCegjcmkJStfUESpDJKhoX4ClfAyTsbw9rzsRBz00iAeUUDQM
NEXT_PUBLIC_STRIPE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Secret Key (DO NOT EXPOSE - backend only)
# WARNING: Never commit this to git. Use Vercel environment variables for production.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay (Public Key - Safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_us_SWhexfqyhpAa3f

# App Configuration
NEXT_PUBLIC_APP_NAME=Kidz Story Magic

# Admin access
# Comma-separated list of emails that should see /admin-dashboard
ADMIN_EMAILS=you@example.com

# Replicate API for Face Swap
# Get your token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Confirmations (Resend)
# Used for payment confirmations, order tracking, and notifications
# Get your API key from https://resend.com/api-keys
# Set up verified sender domain email at https://resend.com/domains
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Kidz Story Magic <orders@kidzstorymagic.com>"
RESEND_REPLY_TO_EMAIL=support@kidzstorymagic.com

# SMS Confirmations (Twilio)
# Used for payment confirmations and status updates via SMS
# Get credentials at https://www.twilio.com/console
# ACCOUNT_SID and AUTH_TOKEN available in Twilio Console
# FROM_PHONE: Your Twilio phone number (format: +1234567890)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

# Email Verification
# URL for email verification links
NEXT_PUBLIC_APP_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400

# Feature Flags
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_FACE_SWAP=true
NEXT_PUBLIC_ENABLE_STORY_GENERATION=true

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=

# For Production Deployment on Vercel:
# Update NEXT_PUBLIC_API_URL to your Vercel backend URL after deployment
# Example: NEXT_PUBLIC_API_URL=https://your-project.vercel.app/api
