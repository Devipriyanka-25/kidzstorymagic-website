# EditorConfig helps maintain consistent coding styles for multiple developers
# working on the same project across various editors and IDEs.
# editorconfig.org

root = true

# Unix-style newlines with a newline ending every file
[*]
indent_style = space
indent_size = 2
end_of_file_fixer = true
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8

# JavaScript files
[*.{js,jsx,ts,tsx}]
indent_size = 2
quote_type = single

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

# SQL files
[*.sql]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Docker
[Dockerfile*]
indent_size = 2
